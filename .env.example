# Charades — environment variables
# Copy this to .env and fill in your values

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# TMDB API key — get one free at https://www.themoviedb.org/settings/api
# Leave empty to use CSV fallback
TMDB_API_KEY=

# Which Indian-language movies to fetch from TMDB (pipe-separated ISO 639-1 codes)
# hi=Hindi, ta=Tamil, te=Telugu, ml=Malayalam
TMDB_LANGUAGES=hi|ta|te|ml

# Number of TMDB result pages to fetch per batch (each page = 20 movies, max=10)
TMDB_PAGES_PER_BATCH=5

# OpenAI API key — when set, AI curates movies and generates hints (optional)
OPENAI_API_KEY=

# OpenAI model for AI game engine (default gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Flask environment: development | production
FLASK_ENV=production

# CORS origins for Vite dev server (comma-separated)
CORS_ORIGINS=http://localhost:5173
